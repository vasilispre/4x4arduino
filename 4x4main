#include <Servo.h>

Servo myServo;

const int IN1 = 2;
const int IN2 = 3;
const int IN3 = 4;
const int IN4 = 5;

const int ENA = 6;
const int ENB = 10;

const int SPEED = 100;

int loopCount = 0; 

void setup() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);
  
  delay(4000);
}


void loop() {
  
  if (loopCount < 3) {
    
    myServo.attach(9);

    analogWrite(ENA, SPEED);
    analogWrite(ENB, SPEED);

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);

    delay(1500);

    analogWrite(ENA, 0);
    analogWrite(ENB, 0);

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);

    delay(4000);

    myServo.write(120);
    delay(250);


myServo.write(90);
    delay(2000);

    myServo.write(60);
    delay(160);

    myServo.write(90);

    delay(1590);
    myServo.detach();

    analogWrite(ENA, SPEED);
    analogWrite(ENB, SPEED);

    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);

    delay(1500);

    analogWrite(ENA, 0);
    analogWrite(ENB, 0);

    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);

    loopCount++;

    if (loopCount < 3) {
      delay(5000);
    }
  } 
  else {
  }
}
